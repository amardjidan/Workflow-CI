FROM python:3.12.7-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    mlflow==2.19.0 \
    pandas \
    numpy \
    scikit-learn \
    joblib

# Copy model artifact
COPY model/ /app/model/

# Expose port
EXPOSE 8080

# Jalankan MLflow model server
CMD ["mlflow", "models", "serve", "-m", "/app/model", "-h", "0.0.0.0", "-p", "8080", "--no-conda"]